# Dữ liệu định tuyến OSRM (lộ trình B16). Dựng lại bằng scripts/build_osrm.sh.
# KHÔNG commit: riêng vietnam-latest.osm.pbf đã 328 MB, và đồ thị .osrm sinh ra
# hàng chục file nhị phân phụ thuộc phiên bản OSRM đang dùng — commit chúng vừa
# làm repo phình vừa làm người khác chạy nhầm đồ thị của phiên bản khác.
osrm/*.osm.pbf
osrm/*.osrm*
