# Copy this file to config/production.env and provide secrets through your
# deployment secret manager. Docker Compose rejects an empty password.
APP_ENV=production
COMPOSE_PROJECT_NAME=nearby-production
LOG_LEVEL=INFO
POSTGRES_DB=nearby
POSTGRES_USER=nearby_app
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
REDIS_PORT=6379
OPENSEARCH_PORT=9200
SEARCH_BACKEND=auto
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_PASSWORD=
GRAPH_BACKEND=auto
BACKEND_PORT=8000
FRONTEND_PORT=3000
GATEWAY_PORT=8080
RATE_LIMIT_PER_MINUTE=120
ALLOWED_ORIGINS=https://nearby.example.com
EVENT_STREAM=nearby:events:v1
CONSUMER_GROUP=realtime-scoring
CONSUMER_NAME=worker-production-1
OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_BBOX=10.70,106.60,10.90,106.82
OSM_MAX_POIS=3000
