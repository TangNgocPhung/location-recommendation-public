# Chép sang config/production.env rồi điền bí mật. File production.env đã được
# .gitignore bỏ qua — KHÔNG commit nó.
#
# Dùng cùng lớp phủ arm64 cho Oracle Cloud Ampere A1:
#
#   docker compose --env-file config/production.env \
#     -f docker-compose.yml -f deploy/docker-compose.prod.yml up -d
#
APP_ENV=production
COMPOSE_PROJECT_NAME=nearby-production
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Tên miền công khai
# ---------------------------------------------------------------------------
# Chưa mua domain thì dùng sslip.io: thay dấu chấm của IP bằng dấu gạch nối,
# ví dụ máy có IP 152.67.1.2 thì PUBLIC_HOST=152-67-1-2.sslip.io. Tên đó tự
# phân giải đúng về IP và Let's Encrypt cấp chứng chỉ bình thường.
PUBLIC_HOST=152-67-1-2.sslip.io
PUBLIC_URL=https://152-67-1-2.sslip.io
# Email nhận cảnh báo chứng chỉ sắp hết hạn. Để trống vẫn xin được chứng chỉ.
ACME_EMAIL=
# Frontend gọi API cùng origin qua gateway, nên chỉ cần đúng một origin.
ALLOWED_ORIGINS=https://152-67-1-2.sslip.io

# ---------------------------------------------------------------------------
# Bí mật — PHẢI đổi, compose từ chối mật khẩu rỗng
# ---------------------------------------------------------------------------
POSTGRES_DB=nearby
POSTGRES_USER=nearby_app
POSTGRES_PASSWORD=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ---------------------------------------------------------------------------
# Cổng — CHỈ nghe trên loopback
# ---------------------------------------------------------------------------
# Trên VPS có IP công khai, "5432:5432" nghĩa là mở Postgres ra cả internet:
# Docker tự chèn luật DNAT vào iptables nên tường lửa của Oracle ở tầng
# Security List KHÔNG chặn được, và bot quét cổng 5432 suốt ngày. Thêm tiền tố
# 127.0.0.1 để chỉ máy chủ tự gọi được. Chỉ Caddy (80/443) mới ra internet.
POSTGRES_PORT=127.0.0.1:5432
REDIS_PORT=127.0.0.1:6379
OPENSEARCH_PORT=127.0.0.1:9200
NEO4J_HTTP_PORT=127.0.0.1:7474
NEO4J_BOLT_PORT=127.0.0.1:7687
BACKEND_PORT=127.0.0.1:8000
FRONTEND_PORT=127.0.0.1:3001
GATEWAY_PORT=127.0.0.1:8081
OSRM_PORT=127.0.0.1:5001
OSRM_FOOT_PORT=127.0.0.1:5002
OSRM_MOTORBIKE_PORT=127.0.0.1:5003

# ---------------------------------------------------------------------------
# Định tuyến OSRM (arm64)
# ---------------------------------------------------------------------------
# Dự án OSRM không publish image arm64 — dựng bằng
# deploy/build-osrm-image-arm64.sh rồi đặt tên ảnh vào đây. Ba script
# scripts/build_osrm*.sh cũng đọc biến OSRM_IMAGE này, nên đồ thị và máy chủ
# định tuyến luôn dùng CÙNG một phiên bản binary — file .osrm gắn chặt với
# phiên bản sinh ra nó.
# CẢNH BÁO PHIÊN BẢN: file .osrm khóa chặt theo binary sinh ra nó. Đồ thị trong
# osrm/ hiện dựng bằng osrm/osrm-backend:latest = v5.26.0, còn
# deploy/build-osrm-image-arm64.sh mặc định ghim v26.9.0. Lệch phiên bản thì
# osrm-routed thoát lúc khởi động, ba container định tuyến chết IM LẶNG và site
# vẫn chạy — chỉ lộ ra khi bấm "Chỉ đường". Xem deploy/RUNBOOK.md mục 5.
# Trên máy amd64 thì đơn giản hơn nhiều: OSRM_IMAGE=osrm/osrm-backend:latest
# khớp sẵn với đồ thị đã có, không phải dựng image.
OSRM_IMAGE=nearby/osrm:arm64

# ---------------------------------------------------------------------------
# Truy xuất
# ---------------------------------------------------------------------------
SEARCH_BACKEND=auto
GRAPH_BACKEND=auto
RATE_LIMIT_PER_MINUTE=120
# Chuỗi proxy là client -> Caddy -> nginx -> backend. Caddy nối IP client vào
# X-Forwarded-For, nginx nối thêm IP của Caddy, nên backend thấy
# [client, caddy] và phải bỏ qua 2 hop để lấy đúng phần tử client. Đặt sai
# thành 0 thì MỌI người dùng dùng chung một hạn mức (IP của nginx); đặt sai
# thành 1 thì lấy nhầm IP của Caddy — cũng dùng chung một hạn mức.
TRUSTED_PROXY_HOPS=2

EVENT_STREAM=nearby:events:v1
CONSUMER_GROUP=realtime-scoring
CONSUMER_NAME=worker-production-1
OVERPASS_URL=https://overpass-api.de/api/interpreter
# PHẢI khớp vùng phủ của ba đồ thị OSRM trong osrm/ (dựng với
# OSRM_BBOX=105.95,10.15,107.45,11.45 — xem scripts/build_osrm.sh). Giá trị cũ
# ở đây là 10.70,106.60,10.90,106.82 / 3000, hẹp hơn nhiều so với vùng đồ thị:
# nhập theo đó thì mất khoảng 7 nghìn POI ngoài trung tâm (dev đo được 15.988
# POI với bbox rộng).
OSM_BBOX=10.20,106.00,11.40,107.40
OSM_MAX_POIS=25000

# Style vector cho bản đồ (tùy chọn). Để trống thì lùi về raster OpenStreetMap.
MAP_STYLE_URL=
