APP_ENV=test
COMPOSE_PROJECT_NAME=nearby-test
LOG_LEVEL=WARNING
POSTGRES_DB=nearby_test
POSTGRES_USER=nearby_test
POSTGRES_PASSWORD=nearby_test_only
POSTGRES_PORT=55432
REDIS_PORT=56379
OPENSEARCH_PORT=59200
SEARCH_BACKEND=auto
NEO4J_HTTP_PORT=57474
NEO4J_BOLT_PORT=57687
NEO4J_PASSWORD=nearby_graph_test
GRAPH_BACKEND=auto
BACKEND_PORT=58000
FRONTEND_PORT=53001
GATEWAY_PORT=58081
RATE_LIMIT_PER_MINUTE=1000
ALLOWED_ORIGINS=http://localhost:53001,http://localhost:58081
EVENT_STREAM=nearby:test:events:v1
CONSUMER_GROUP=realtime-scoring-test
CONSUMER_NAME=worker-test-1
OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_BBOX=10.70,106.60,10.90,106.82
OSM_MAX_POIS=250

# API luôn nằm sau gateway NGINX (đúng 1 proxy), nên phần tử cuối của
# X-Forwarded-For là IP thật do nginx nhìn thấy. Đặt 0 nếu chạy API trực tiếp.
TRUSTED_PROXY_HOPS=1
