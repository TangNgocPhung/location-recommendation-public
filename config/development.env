APP_ENV=development
COMPOSE_PROJECT_NAME=nearby-dev
LOG_LEVEL=INFO
POSTGRES_DB=nearby_dev
POSTGRES_USER=nearby_dev
POSTGRES_PASSWORD=nearby_dev_only
POSTGRES_PORT=5432
REDIS_PORT=6379
OPENSEARCH_PORT=9200
SEARCH_BACKEND=auto
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_PASSWORD=nearby_graph_dev
GRAPH_BACKEND=auto
BACKEND_PORT=8000
FRONTEND_PORT=3001
GATEWAY_PORT=8081
RATE_LIMIT_PER_MINUTE=120
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:8081,http://127.0.0.1:8081
EVENT_STREAM=nearby:events:v1
CONSUMER_GROUP=realtime-scoring
CONSUMER_NAME=worker-development-1
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Mở rộng 2026-09-14 (từ 10.70,106.60,10.90,106.82 / 3000): vùng trung tâm đã
# cạn POI có tên trên OSM (~9k), muốn ~16k phải phủ thêm Củ Chi, Long An, Biên
# Hòa, Nhơn Trạch. Đồ thị OSRM trong ./osrm phải dựng với bbox tương ứng —
# xem OSRM_BBOX trong scripts/build_osrm.sh.
OSM_BBOX=10.20,106.00,11.40,107.40
OSM_MAX_POIS=25000

# API luôn nằm sau gateway NGINX (đúng 1 proxy), nên phần tử cuối của
# X-Forwarded-For là IP thật do nginx nhìn thấy. Đặt 0 nếu chạy API trực tiếp.
TRUSTED_PROXY_HOPS=1

# Cong cua service osrm-motorbike (Phase 12.8)
OSRM_MOTORBIKE_PORT=5003
