# Backward-compatible template for running the API directly on the host.
# Docker Compose uses the explicit files under config/ instead.
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql://nearby_dev:nearby_dev_only@localhost:5432/nearby_dev
REDIS_URL=redis://localhost:6379/0
# Truy xuất đa kênh. auto = dùng OpenSearch nếu kết nối được, tự fallback PostGIS.
SEARCH_BACKEND=auto
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=nearby-pois
# Knowledge Graph. auto = dùng Neo4j nếu kết nối được, tự bỏ qua khi không.
GRAPH_BACKEND=auto
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=nearby_graph_dev
EVENT_STREAM=nearby:events:v1
RATE_LIMIT_PER_MINUTE=120
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081
NEXT_PUBLIC_API_URL=http://localhost:8000

# Style vector cho bản đồ. Bỏ trống thì frontend tự lùi về raster OpenStreetMap.
# Lấy key miễn phí ở https://cloud.maptiler.com → API Keys, rồi nhớ giới hạn
# Allowed HTTP origins cho key đó vì key nằm ở phía trình duyệt, ai xem nguồn cũng thấy.
# MAP_STYLE_URL=https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_KEY

# Google Places API (New) — nguon rating that cho POI nhap tu OpenStreetMap.
# OSM khong co truong danh gia, nen 2982/3010 POI hien khong co rating.
#
# Tao key o Google Cloud Console, bat "Places API (New)", gan tai khoan thanh
# toan, va GIOI HAN key theo API + theo IP. Moi truy van deu tinh phi: 3010
# POI la 3010 truy van, nen luon chay `--dry-run` trong lan dau.
#
# De rong thi buoc lam giau bi bo qua; he thong van chay voi rating NULL.
# GOOGLE_MAPS_API_KEY=
